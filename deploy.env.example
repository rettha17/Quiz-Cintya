# Salin file ini menjadi "deploy.env" lalu isi sesuai data SSH Hostinger kamu.
# deploy.env TIDAK ikut ke git (sudah masuk .gitignore) karena berisi info koneksi server.

# Hostname/IP SSH, contoh: 123456.hostingerapp.com
SSH_HOST=

# Port SSH Hostinger (lihat di hPanel > Advanced > SSH Access), contoh: 65002
SSH_PORT=22

# Username SSH Hostinger, contoh: u123456789
SSH_USER=

# Path lengkap folder tujuan di server, contoh: public_html atau public_html/quiz_bps
REMOTE_PATH=public_html

# Path private key yang dipakai untuk login (jangan diubah kalau ikut setup awal)
SSH_KEY=~/.ssh/hostinger_quizbps
